# Telegram bot token from @BotFather
TELEGRAM_TOKEN=
# Anthropic API key (newsletter parsing)
ANTHROPIC_API_KEY=
# Dedicated Gmail inbox subscribed to brand newsletters (use an App Password, 2FA required)
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com

# Optional
DB_URL=sqlite+aiosqlite:///salebot.db
NEWSLETTER_INTERVAL_MIN=5
PRICE_CHECK_INTERVAL_HOURS=4
PRICE_DROP_MIN_PCT=1.0
MAX_FETCH_FAILURES=5
